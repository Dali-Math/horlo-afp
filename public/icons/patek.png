<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 80" width="200" height="80">
  <defs>
    <linearGradient id="goldP" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FCE588"/>
      <stop offset="50%" stop-color="#E2B44F"/>
      <stop offset="100%" stop-color="#B8860B"/>
    </linearGradient>
  </defs>
  <!-- Croix de Calatrava (Patek Philippe) -->
  <g transform="translate(100, 20) scale(0.68)" fill="url(#goldP)">
    <!-- Central diamond -->
    <polygon points="0,-4 4,0 0,4 -4,0"/>
    <!-- Top fleur -->
    <path d="M0,-3 Q-4,-10 0,-18 Q4,-10 0,-3"/>
    <path d="M0,-9 Q-7,-10 -9,-14 Q-4,-14 0,-9"/>
    <path d="M0,-9 Q7,-10 9,-14 Q4,-14 0,-9"/>
    <!-- Bottom fleur -->
    <path d="M0,3 Q-4,10 0,18 Q4,10 0,3"/>
    <path d="M0,9 Q-7,10 -9,14 Q-4,14 0,9"/>
    <path d="M0,9 Q7,10 9,14 Q4,14 0,9"/>
    <!-- Left fleur -->
    <path d="M-3,0 Q-10,-4 -18,0 Q-10,4 -3,0"/>
    <path d="M-9,0 Q-10,-7 -14,-9 Q-14,-4 -9,0"/>
    <path d="M-9,0 Q-10,7 -14,9 Q-14,4 -9,0"/>
    <!-- Right fleur -->
    <path d="M3,0 Q10,-4 18,0 Q10,4 3,0"/>
    <path d="M9,0 Q10,-7 14,-9 Q14,-4 9,0"/>
    <path d="M9,0 Q10,7 14,9 Q14,4 9,0"/>
  </g>
  <text x="100" y="53" text-anchor="middle" fill="#FFFFFF" font-family="'Times New Roman', 'Cinzel', serif" font-size="16" font-weight="bold" letter-spacing="2.5">PATEK PHILIPPE</text>
  <text x="100" y="68" text-anchor="middle" fill="url(#goldP)" font-family="'Montserrat', sans-serif" font-size="7.5" font-weight="600" letter-spacing="4">GENEVE</text>
</svg>