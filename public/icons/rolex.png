<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 80" width="200" height="80">
  <defs>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FCE588"/>
      <stop offset="50%" stop-color="#D4AF37"/>
      <stop offset="100%" stop-color="#AA7C11"/>
    </linearGradient>
  </defs>
  <!-- Rolex Coronet 5-points -->
  <g transform="translate(100, 22)" fill="url(#gold)" stroke="none">
    <!-- Center Pearl -->
    <circle cx="0" cy="-14" r="2.8"/>
    <!-- Left Pearls -->
    <circle cx="-13" cy="-10" r="2.5"/>
    <circle cx="-24" cy="-3" r="2.2"/>
    <!-- Right Pearls -->
    <circle cx="13" cy="-10" r="2.5"/>
    <circle cx="24" cy="-3" r="2.2"/>
    <!-- Spikes & Crown Base -->
    <path d="M-22,-1 L-16,3 L-12,-8 L-8,4 L0,-11 L8,4 L12,-8 L16,3 L22,-1 L18,7 L-18,7 Z"/>
    <!-- Bottom Rim -->
    <path d="M-19,8.5 Q0,10.5 19,8.5 L19,10.5 Q0,12.5 -19,10.5 Z"/>
  </g>
  <!-- Typography ROLEX -->
  <text x="100" y="55" text-anchor="middle" fill="#FFFFFF" font-family="'Times New Roman', 'Cinzel', 'Playfair Display', serif" font-size="22" font-weight="bold" letter-spacing="4">ROLEX</text>
  <!-- Subtitle GENEVE -->
  <text x="100" y="69" text-anchor="middle" fill="url(#gold)" font-family="'Montserrat', sans-serif" font-size="7.5" font-weight="600" letter-spacing="3.5">GENÈVE</text>
</svg>